//@version=6

//==================================================================================================
// Quant SMC Pro
// Version : 0.1.0
//
// Institutional Smart Money Strategy
//
// Author : ChatGPT
//
// This project is intentionally modular.
// Every engine is isolated so future versions can easily add:
//
// • Order Blocks
// • Fair Value Gaps
// • Liquidity
// • Premium / Discount
// • Dashboard
// • Statistics
//
//==================================================================================================

strategy(
     title="Quant SMC Pro",
     shorttitle="QSMC",
     overlay=true,
     initial_capital=10000,
     pyramiding=0,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     max_labels_count=500,
     max_lines_count=500)

//==================================================================================================
// VERSION
//==================================================================================================

VERSION = "0.1.0"

//==================================================================================================
// INPUT GROUPS
//==================================================================================================

GROUP_TREND = "Trend"

GROUP_SWING = "Swing Detection"

GROUP_RISK = "Risk"

GROUP_VISUAL = "Visual"

GROUP_ALERT = "Alerts"

GROUP_DEBUG = "Debug"

//==================================================================================================
// TREND INPUTS
//==================================================================================================

useEMAFilter =
    input.bool(
         true,
         "Enable EMA Filter",
         group=GROUP_TREND)

emaFastLength =
    input.int(
         50,
         "Fast EMA",
         minval=1,
         group=GROUP_TREND)

emaSlowLength =
    input.int(
         200,
         "Slow EMA",
         minval=1,
         group=GROUP_TREND)

useHigherTF =
    input.bool(
         false,
         "Enable Higher Timeframe Filter",
         group=GROUP_TREND)

higherTF =
    input.timeframe(
         "240",
         "Higher Timeframe",
         group=GROUP_TREND)

//==================================================================================================
// SWING
//==================================================================================================

pivotLength =
    input.int(
         5,
         "Pivot Length",
         minval=2,
         maxval=20,
         group=GROUP_SWING)

minimumSwingTicks =
    input.int(
         20,
         "Minimum Swing Size",
         minval=1,
         group=GROUP_SWING)

//==================================================================================================
// RISK
//==================================================================================================

stopMode =
    input.string(
         "ATR",
         "Stop Loss",
         options=[
             "ATR",
             "Swing",
             "Percent"
         ],
         group=GROUP_RISK)

riskReward =
    input.float(
         3.0,
         "Risk Reward",
         step=.5,
         group=GROUP_RISK)

riskPercent =
    input.float(
         1.0,
         "Risk %",
         step=.25,
         group=GROUP_RISK)

atrLength =
    input.int(
         14,
         "ATR Length",
         group=GROUP_RISK)

atrMultiplier =
    input.float(
         2.0,
         "ATR Multiplier",
         step=.25,
         group=GROUP_RISK)

//==================================================================================================
// VISUAL
//==================================================================================================

showEMA =
    input.bool(
         true,
         "Show EMA",
         group=GROUP_VISUAL)

showSwings =
    input.bool(
         true,
         "Show Swings",
         group=GROUP_VISUAL)

showLabels =
    input.bool(
         true,
         "Show Labels",
         group=GROUP_VISUAL)

bullColor =
    input.color(
         color.lime,
         "Bullish Color",
         group=GROUP_VISUAL)

bearColor =
    input.color(
         color.red,
         "Bearish Color",
         group=GROUP_VISUAL)

//==================================================================================================
// ALERTS
//==================================================================================================

enableAlerts =
    input.bool(
         true,
         "Enable Alerts",
         group=GROUP_ALERT)

//==================================================================================================
// DEBUG
//==================================================================================================

debugMode =
    input.bool(
         false,
         "Debug Mode",
         group=GROUP_DEBUG)

//==================================================================================================
// ENUMS
//==================================================================================================

TREND_BULL = 1

TREND_BEAR = -1

TREND_NONE = 0

STRUCTURE_NONE = 0

STRUCTURE_HH = 1

STRUCTURE_HL = 2

STRUCTURE_LH = 3

STRUCTURE_LL = 4

//==================================================================================================
// VARIABLES
//==================================================================================================

var float lastSwingHigh = na

var float lastSwingLow = na

var int lastSwingHighBar = na

var int lastSwingLowBar = na

var int currentTrend = TREND_NONE

//==================================================================================================
// OBJECT STORAGE
//==================================================================================================

var swings = array.new<Swing>()

var structures = array.new<StructureEvent>()
//==================================================================================================
// CUSTOM TYPES
//==================================================================================================

// Confirmed market swing
type Swing
    float price
    int   bar
    bool  isHigh
    int   structure

// Structure event (BOS / CHoCH later)
type StructureEvent
    float level
    int   bar
    bool  bullish
    string name
//==================================================================================================
// UTILITY FUNCTIONS
//==================================================================================================

// Round to Tick

roundTick(float value)=>

    math.round(value/syminfo.mintick)*syminfo.mintick

// ATR

getATR()=>

    ta.atr(atrLength)

// Distance

distance(float a,float b)=>

    math.abs(a-b)

// Higher TF EMA

getHTFEMA(int len)=>

    request.security(
         syminfo.tickerid,
         higherTF,
         ta.ema(close,len))

// Label Helper

drawLabel(
     int x,
     float y,
     string txt,
     color c,
     bool up)=>

    label.new(
         x=x,
         y=y,
         text=txt,
         color=c,
         textcolor=color.white,
         style=
             up?
             label.style_label_up:
             label.style_label_down,
         size=size.tiny)
//==================================================================================================
// SWING HELPERS
//==================================================================================================

// Save a swing
addSwing(float price, int bar, bool isHigh, int structure)=>

    Swing s = Swing.new(
        price,
        bar,
        isHigh,
        structure)

    array.push(swings, s)

// Number of swings
swingCount()=>

    array.size(swings)

// Last swing
lastSwing()=>

    swingCount() > 0 ?
    array.get(swings, swingCount()-1) :
    na

// Previous swing
previousSwing()=>

    swingCount() > 1 ?
    array.get(swings, swingCount()-2) :
    na
//==================================================================================================
// END PART 1
//==================================================================================================
// TREND ENGINE
//==================================================================================================

// Core calculations

emaFast = ta.ema(close, emaFastLength)
emaSlow = ta.ema(close, emaSlowLength)

atr = ta.atr(atrLength)

htfEMA =
    useHigherTF ?
    request.security(
        syminfo.tickerid,
        higherTF,
        ta.ema(close, emaSlowLength),
        lookahead = barmerge.lookahead_off
    ) :
    na

//--------------------------------------------------------------------------------------------------
// Trend Detection
//--------------------------------------------------------------------------------------------------

bullEMA = emaFast > emaSlow
bearEMA = emaFast < emaSlow

bullHTF =
    not useHigherTF ?
    true :
    close > htfEMA

bearHTF =
    not useHigherTF ?
    true :
    close < htfEMA

trendLong =
    bullEMA and bullHTF

trendShort =
    bearEMA and bearHTF

currentTrend :=
    trendLong ?
    TREND_BULL :
    trendShort ?
    TREND_BEAR :
    TREND_NONE

//--------------------------------------------------------------------------------------------------
// Trend Helper Functions
//--------------------------------------------------------------------------------------------------

trendLong() =>
    currentTrend == TREND_BULL

trendShort() =>
    currentTrend == TREND_BEAR

currentTrend() =>
    currentTrend == TREND_NONE

//--------------------------------------------------------------------------------------------------
// Trend Strength
//--------------------------------------------------------------------------------------------------

emaDistance =
    math.abs(emaFast - emaSlow)

trendStrength =
    emaDistance / atr

//--------------------------------------------------------------------------------------------------
// Plot EMA
//--------------------------------------------------------------------------------------------------

plot(
    showEMA ? emaFast : na,
    title="EMA Fast",
    linewidth=2,
    color=color.orange)

plot(
    showEMA ? emaSlow : na,
    title="EMA Slow",
    linewidth=2,
    color=color.blue)

//--------------------------------------------------------------------------------------------------
// Background
//--------------------------------------------------------------------------------------------------

bgcolor(
    currentTrend == TREND_BULL ?
    color.new(color.green,92) :
    currentTrend == TREND_BEAR ?
    color.new(color.red,92) :
    na)

//--------------------------------------------------------------------------------------------------
// Debug
//--------------------------------------------------------------------------------------------------

plot(
    debugMode ?
    trendStrength :
    na,
    title="Trend Strength",
    color=color.white)

//==================================================================================================
// ATR FUNCTIONS
//==================================================================================================

getLongATRStop(float entry)=>

    entry-(atr*atrMultiplier)

getShortATRStop(float entry)=>

    entry+(atr*atrMultiplier)

//==================================================================================================
// END TREND ENGINE
//==================================================================================================
//==================================================================================================
// SWING ENGINE
//==================================================================================================

// Confirmed pivots
pivotHigh = ta.pivothigh(high, pivotLength, pivotLength)
pivotLow  = ta.pivotlow(low, pivotLength, pivotLength)

// Current confirmed swings
var float confirmedHigh = na
var float confirmedLow  = na

var int confirmedHighBar = na
var int confirmedLowBar  = na

// Previous confirmed swings
var float previousHigh = na
var float previousLow  = na

// Structure types
var int lastHighStructure = STRUCTURE_NONE
var int lastLowStructure  = STRUCTURE_NONE

//--------------------------------------------------------------------------------------------------
// Detect High Pivot
//--------------------------------------------------------------------------------------------------

if not na(pivotHigh)

    previousHigh := confirmedHigh

    confirmedHigh := pivotHigh

    confirmedHighBar := bar_index - pivotLength

    if not na(previousHigh)

        lastHighStructure :=
            confirmedHigh > previousHigh ?
            STRUCTURE_HH :
            STRUCTURE_LH

addSwing(
    confirmedHigh,
    confirmedHighBar,
    true,
    lastHighStructure)

//--------------------------------------------------------------------------------------------------
// Detect Low Pivot
//--------------------------------------------------------------------------------------------------

if not na(pivotLow)

    previousLow := confirmedLow

    confirmedLow := pivotLow

    confirmedLowBar := bar_index - pivotLength

    if not na(previousLow)

        lastLowStructure :=
            confirmedLow > previousLow ?
            STRUCTURE_HL :
            STRUCTURE_LL

addSwing(
    confirmedLow,
    confirmedLowBar,
    false,
    lastLowStructure)

//--------------------------------------------------------------------------------------------------
// Draw Swing Labels
//--------------------------------------------------------------------------------------------------

if showLabels and not na(pivotHigh)

    txt =
        lastHighStructure == STRUCTURE_HH ?
        "HH" :
        "LH"

drawSwingLabel(
    confirmedHighBar,
    confirmedHigh,
    txt,
    true)

if showLabels and not na(pivotLow)

    txt =
        lastLowStructure == STRUCTURE_HL ?
        "HL" :
        "LL"

drawSwingLabel(
    confirmedLowBar,
    confirmedLow,
    txt,
    false)
//==================================================================================================
// DRAWING HELPERS
//==================================================================================================

drawSwingLabel(
    int bar,
    float price,
    string text,
    bool high)=>

    label.new(
        x = bar,
        y = price,
        text = text,
        style = high ? label.style_label_down : label.style_label_up,
        color = high ? bearColor : bullColor,
        textcolor = color.white,
        size = size.tiny)
//--------------------------------------------------------------------------------------------------
// Plot Swing Markers
//--------------------------------------------------------------------------------------------------

plotshape(
     showSwings and not na(pivotHigh),
     style=shape.triangledown,
     location=location.abovebar,
     color=bearColor,
     size=size.tiny)

plotshape(
     showSwings and not na(pivotLow),
     style=shape.triangleup,
     location=location.belowbar,
     color=bullColor,
     size=size.tiny)

//--------------------------------------------------------------------------------------------------
// Debug Information
//--------------------------------------------------------------------------------------------------

plotchar(
     debugMode ? confirmedHigh : na,
     title="Confirmed High",
     char="H",
     location=location.top)

plotchar(
     debugMode ? confirmedLow : na,
     title="Confirmed Low",
     char="L",
     location=location.bottom)

//==================================================================================================
// END SWING ENGINE
//==================================================================================================
